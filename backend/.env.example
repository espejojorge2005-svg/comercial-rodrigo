# Environment variables for Comercial Rodrigo Backend

PORT=4000
NODE_ENV=development

# Supabase PostgreSQL Connection
# DATABASE_URL uses transaction pooler (port 6543)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"

# DIRECT_URL uses direct connection (port 5432) for Prisma migrations
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# JWT Auth Secret & Expiration
JWT_SECRET="comercial_rodrigo_super_secret_jwt_key_2026_xyz"
JWT_EXPIRES_IN="12h"

# =============================================================================
# FACTURACIÓN ELECTRÓNICA SUNAT (API PSE / NUBEFACT / APISPERU)
# =============================================================================
# BILLING_DRIVER: 'MOCK' (Simulación interna) o 'NUBEFACT' (Emisión real SUNAT)
BILLING_DRIVER=MOCK
# URL de la API del PSE (ej: Sandbox https://demo.nubefact.com/api/v1/ o Producción)
NUBEFACT_URL="https://api.nubefact.com/api/v1/tu-ruta"
# Token Bearer proporcionado por tu PSE
NUBEFACT_TOKEN="tu_token_autorizacion_aqui"
